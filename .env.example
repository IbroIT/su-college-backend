# Пример файла с переменными окружения для Heroku
# Установите эти переменные через Heroku Dashboard или CLI

# SECRET_KEY для Django (обязательно измените!)
DJANGO_SECRET_KEY=your-secret-key-here-change-me

# Режим отладки (False для продакшена)
DJANGO_DEBUG=False

# База данных (Heroku автоматически установит DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
