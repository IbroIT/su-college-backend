# Пример файла с переменными окружения
# Скопируйте в .env и заполните своими значениями

# Django настройки
DJANGO_SECRET_KEY=your-secret-key-here-change-me
DJANGO_DEBUG=False

# База данных (на Heroku автоматически установится DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# DigitalOcean Spaces настройки для медиа файлов
USE_SPACES=True
SPACES_KEY=your-spaces-access-key
SPACES_SECRET=your-spaces-secret-key
SPACES_NAME=su-college
SPACES_REGION=blr1
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
